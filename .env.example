# Copy this file to  .env  on the server and fill it in.  NEVER share .env or put it in git.

# your website address, without https://
DOMAIN=quotes.example.com

# a long random text: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-text-of-at-least-32-characters

DJANGO_ALLOWED_HOSTS=quotes.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://quotes.example.com

# leave 0 until you have checked that https works everywhere, then 31536000
DJANGO_HSTS_SECONDS=0

# false = NO sign-in: everybody who has the address can use the app and see ALL quotations (for a test period only).
# true  = everybody has to sign in (create users with:  docker compose exec web python manage.py createsuperuser)
DJANGO_REQUIRE_LOGIN=false
